<?xml version="1.0" encoding="utf-8"?>
<!-- The bot trainer (console app). Shares the plugin's grader, rulebook and engine physics, plus RocketSim.
     Open RLCoachTrainer.slnx (this folder), pick Release | x64, Build. The exe lands in build\trainer\. -->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <ProjectGuid>{6b1f2c4e-8d3a-4e7b-9a52-2f0c7d1e5a93}</ProjectGuid>
    <RootNamespace>RLCoachTrainer</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <!-- The shared files include the plugin's pch.h, which needs the BakkesMod SDK headers (nothing from it is linked) -->
    <BakkesModPath>$(registry:HKEY_CURRENT_USER\Software\BakkesMod\AppPath@BakkesModPath)</BakkesModPath>
    <RepoDir>$(ProjectDir)..\</RepoDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <LinkIncremental>false</LinkIncremental>
    <OutDir>$(RepoDir)build\trainer\</OutDir>
    <IntDir>$(RepoDir)build\.intermediates\trainer\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <Optimization>MaxSpeed</Optimization>
      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>NDEBUG;_CONSOLE;_CRT_SECURE_NO_WARNINGS;RS_DONT_LOG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <EnableEnhancedInstructionSet>AdvancedVectorExtensions2</EnableEnhancedInstructionSet>
      <AdditionalIncludeDirectories>$(RepoDir);$(BakkesModPath)\bakkesmodsdk\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>

    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <StackReserveSize>8388608</StackReserveSize>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- The trainer -->
    <ClCompile Include="Main.cpp" />
    <ClCompile Include="Trainer.cpp" />
    <ClCompile Include="Bot.cpp" />
    <ClCompile Include="Net.cpp" />
    <ClCompile Include="LineSim.cpp" />
    <ClCompile Include="Data.cpp" />
    <!-- Shared with the plugin (same files, not copies) -->
    <ClCompile Include="..\Engine.cpp" />
    <ClCompile Include="..\Grader.cpp" />
    <ClCompile Include="..\Mechanics.cpp" />
    <ClCompile Include="..\ShotGeometry.cpp" />
    <ClCompile Include="..\Segmenter.cpp" />
    <ClCompile Include="..\ShotBook.cpp" />
    <ClCompile Include="..\RepLibrary.cpp" />
    <ClCompile Include="..\RepStore.cpp" />
    <ClCompile Include="..\third_party\miniz\miniz.c">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
    </ClCompile>
    <!-- RocketSim (MIT license) and its bundled Bullet physics, built exactly like the plugin builds them -->
    <ClCompile Include="..\third_party\RocketSim\src\**\*.cpp;..\third_party\RocketSim\libsrc\**\*.cpp">
      <ConformanceMode>false</ConformanceMode>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="Trainer.h" />
    <ClInclude Include="Bot.h" />
    <ClInclude Include="Net.h" />
    <ClInclude Include="LineSim.h" />
    <ClInclude Include="Data.h" />
    <ClInclude Include="..\EngineSim.h" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" />
    <None Include="StartTraining.bat" />
    <None Include="CheckBot.bat" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
